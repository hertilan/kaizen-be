generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  FINANCE
  RETAILER
  WHOLESALE
  ENGINEER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum StockTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  TRANSFER
}

enum ExpenseCategory {
  TRANSPORT
  PROCUREMENT
  SALARIES
  UTILITIES
  OFFICE_EXPENSES
  MAINTENANCE
  OPERATIONS
  OTHER
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
}

enum PaymentDirection {
  IN
  OUT
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  PENDING_APPROVAL
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AlertKind {
  LOW_STOCK
  OUT_OF_STOCK
  ADJUSTMENT
}

enum NotificationCategory {
  STOCK
  TASK
  FINANCE
  SYSTEM
}

enum NotificationSeverity {
  INFO
  WARNING
  DANGER
  SUCCESS
}

model User {
  id            String         @id @default(uuid())
  userId        String         @unique @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(ENGINEER)
  active        Boolean        @default(true)
  avatarUrl     String?
  assignedTasks Task[]        @relation("AssigneeTasks")
  notifications Notification[] @relation("UserNotifications")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Notification {
  id        String               @id @default(uuid())
  title     String
  message   String
  category  NotificationCategory @default(SYSTEM)
  severity  NotificationSeverity @default(INFO)
  isRead    Boolean              @default(false)
  userId    String?
  targetUrl String?
  metadata  Json?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user User? @relation("UserNotifications", fields: [userId], references: [userId], onDelete: Cascade)
}

model Category {
  id               String     @id @default(uuid())
  categoryId       String     @unique @default(uuid())
  name             String
  parentCategoryId String?
  parentCategory   Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [categoryId])
  subCategories    Category[] @relation("CategoryHierarchy")
  products         Product[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Product {
  id            String              @id @default(uuid())
  productId     String              @unique @default(uuid())
  code          String              @unique
  name          String
  categoryId    String
  category      Category            @relation(fields: [categoryId], references: [categoryId])
  unit          String
  purchasePrice Float
  sellingPrice  Float
  stockQty      Int                 @default(0)
  reorderLevel  Int                 @default(0)
  status        ProductStatus       @default(ACTIVE)
  transactions  StockTransaction[]
  alerts        AlertItem[]
  purchaseItems PurchaseItem[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model Supplier {
  id               String     @id @default(uuid())
  supplierId       String     @unique @default(uuid())
  name             String
  contactPerson    String
  phone            String
  email            String
  address          String
  productsSupplied String[]
  purchases        Purchase[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Purchase {
  id            String         @id @default(uuid())
  purchaseId    String         @unique @default(uuid())
  purchaseNumber String        @unique
  supplierId    String
  supplier      Supplier       @relation(fields: [supplierId], references: [supplierId])
  date          DateTime       @default(now())
  paymentStatus PaymentStatus  @default(UNPAID)
  notes         String?
  items         PurchaseItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [purchaseId], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [productId])
  quantity   Int
  unitPrice  Float
}

model StockTransaction {
  id            String               @id @default(uuid())
  transactionId String               @unique @default(uuid())
  productId     String
  product       Product              @relation(fields: [productId], references: [productId])
  type          StockTransactionType
  quantity      Int
  date          DateTime             @default(now())
  reference     String
  reason        String?
  createdAt     DateTime             @default(now())
}

model AlertItem {
  id        String    @id @default(uuid())
  alertId   String    @unique @default(uuid())
  productId String
  product   Product   @relation(fields: [productId], references: [productId])
  kind      AlertKind
  message   String
  date      DateTime  @default(now())
  createdAt DateTime  @default(now())
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceId     String        @unique @default(uuid())
  invoiceNumber String        @unique
  customerName  String
  date          DateTime      @default(now())
  dueDate       DateTime
  status        PaymentStatus @default(UNPAID)
  notes         String?
  items         InvoiceItem[]
  tasks         Task[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
  productId   String?
  description String
  quantity    Int
  unitPrice   Float
}

model Expense {
  id                String          @id @default(uuid())
  expenseId         String          @unique @default(uuid())
  category          ExpenseCategory
  description       String
  amount            Float
  date              DateTime        @default(now())
  paymentMethod     PaymentMethod
  responsiblePerson String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Payment {
  id        String           @id @default(uuid())
  paymentId String           @unique @default(uuid())
  direction PaymentDirection
  method    PaymentMethod
  amount    Float
  date      DateTime         @default(now())
  reference String
  notes     String?
  createdAt DateTime         @default(now())
}

model Task {
  id          String             @id @default(uuid())
  taskId      String             @unique @default(uuid())
  title       String
  description String?
  status      TaskStatus         @default(NOT_STARTED)
  priority    TaskPriority       @default(MEDIUM)
  assigneeId  String
  assignee    User               @relation("AssigneeTasks", fields: [assigneeId], references: [userId])
  department  String
  startDate   DateTime
  dueDate     DateTime
  createdDate DateTime           @default(now())
  invoiceId   String?
  invoice     Invoice?           @relation(fields: [invoiceId], references: [invoiceId])
  comments    TaskComment[]
  history     TaskHistoryEntry[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model TaskComment {
  id         String   @id @default(uuid())
  commentId  String   @unique @default(uuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  authorName String
  message    String
  date       DateTime @default(now())
}

model TaskHistoryEntry {
  id        String   @id @default(uuid())
  entryId   String   @unique @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  message   String
  date      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// FINANCE DEPARTMENT DOMAIN MODELS
// ---------------------------------------------------------------------------

model FinanceAccount {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  type          String
  balance       Float    @default(0)
  currency      String   @default("RWF")
  isSubLedger   Boolean  @default(false)
  accountNumber String?
  bankName      String?
  description   String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model FinanceTransaction {
  id                   String   @id @default(uuid())
  date                 String
  description          String
  type                 String
  sourceAccountId      String
  destinationAccountId String?
  amount               Float
  expenditureCodeId    String?
  reference            String?
  notes                String?
  createdAt            DateTime @default(now())
}

model ExpenditureCode {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  category    String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Debtor {
  id           String                @id @default(uuid())
  date         String
  customerName String
  item         String
  phoneNumber  String
  interestRate Float
  capital      Float
  interest     Float
  total        Float
  dueDate      String
  amountPaid   Float                 @default(0)
  status       String                @default("UNPAID")
  notes        String?
  payments     DebtorPaymentRecord[]
  createdAt    DateTime              @default(now())
}

model DebtorPaymentRecord {
  id        String   @id @default(uuid())
  debtorId  String
  debtor    Debtor   @relation(fields: [debtorId], references: [id], onDelete: Cascade)
  date      String
  amount    Float
  accountId String
  reference String?
  notes     String?
  createdAt DateTime @default(now())
}

model Creditor {
  id           String                  @id @default(uuid())
  date         String
  supplierName String
  item         String
  detail       String
  amount       Float
  totalAmount  Float
  dueDate      String
  amountPaid   Float                   @default(0)
  status       String                  @default("UNPAID")
  notes        String?
  payments     CreditorPaymentRecord[]
  createdAt    DateTime                @default(now())
}

model CreditorPaymentRecord {
  id         String   @id @default(uuid())
  creditorId String
  creditor   Creditor @relation(fields: [creditorId], references: [id], onDelete: Cascade)
  date       String
  amount     Float
  accountId  String
  reference  String?
  notes      String?
  createdAt  DateTime @default(now())
}

model FixedAsset {
  id               String   @id @default(uuid())
  code             String   @unique
  assetName        String
  category         String
  acquisitionDate  String
  purchaseValue    Float
  currentValuation Float
  location         String
  condition        String
  notes            String?
  createdAt        DateTime @default(now())
}

// ---------------------------------------------------------------------------
// SUPPLIER & DISTRIBUTION MODELS
// ---------------------------------------------------------------------------

model SDShop {
  id         String   @id @default(uuid())
  name       String
  type       String
  sellerName String
  location   String
  createdAt  DateTime @default(now())
}

model SDCategory {
  id          String               @id @default(uuid())
  code        String               @unique
  name        String
  description String?
  template    SDAttributeTemplate?
  createdAt   DateTime             @default(now())
}

model SDAttributeTemplate {
  id           String     @id @default(uuid())
  categoryId   String     @unique
  category     SDCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryName String
  fields       Json
  createdAt    DateTime   @default(now())
}

model SDProduct {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  categoryId      String
  categoryName    String
  attributeValues Json
  unit            String
  purchasePrice   Float
  sellingPrice    Float
  shopId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SDPurchase {
  id             String           @id @default(uuid())
  purchaseNumber String           @unique
  date           String
  shopId         String
  supplierName   String
  totalQuantity  Int
  totalAmount    Float
  notes          String?
  items          SDPurchaseItem[]
  createdAt      DateTime         @default(now())
}

model SDPurchaseItem {
  id          String     @id @default(uuid())
  purchaseId  String
  purchase    SDPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  quantity    Int
  unitPrice   Float
  total       Float
}

model SDSale {
  id              String       @id @default(uuid())
  saleNumber      String       @unique
  date            String
  clientId        String
  clientName      String
  channel         String
  shopId          String
  totalQuantity   Int
  totalAmount     Float
  totalCost       Float
  profitMargin    Float
  amountPaid      Float
  amountOwed      Float
  financeDebtorId String?
  notes           String?
  items           SDSaleItem[]
  createdAt       DateTime     @default(now())
}

model SDSaleItem {
  id           String @id @default(uuid())
  saleId       String
  sale         SDSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String
  productName  String
  quantity     Int
  unitPrice    Float
  unitCost     Float
  total        Float
  profitMargin Float
}

enum ClientType {
  PERSON
  BUSINESS
}

enum LegalStructure {
  SOLE_PROPRIETORSHIP
  LIMITED_LIABILITY
  PUBLIC_LIMITED
  NGO
  OTHER
}

model SDClient {
  id                  String          @id @default(uuid())
  clientType          ClientType      @default(PERSON)
  name                String
  phone               String
  email               String
  address             String
  channel             String          @default("RETAIL")
  shopId              String          @default("ALL")
  tradingName         String?
  tin                 String?
  registrationDate    String?
  legalStructure      LegalStructure?
  otherLegalStructure String?
  businessNature      String?
  contactPerson       String?
  totalPurchased      Float           @default(0)
  amountOwed          Float           @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @default(now()) @updatedAt
}

// ============================================================================
// ENGINEERING DEPARTMENT MODELS
// ============================================================================

model EngProject {
  id            String           @id @default(uuid())
  projectNumber String           @unique
  projectName   String
  clientName    String
  clientContact String
  ownerId       String
  ownerName     String
  startDate     String
  endDate       String
  status        String           @default("QUOTED")
  quotationRef  String?
  lpoRef        String?
  invoiceRef    String?
  location      String?
  description   String?
  transactions  EngTransaction[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model EngTransaction {
  id                  String     @id @default(uuid())
  projectId           String
  project             EngProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date                String
  description         String
  type                String
  expenditureCategory String?
  amount              Float
  accountId           String
  accountName         String
  isInternalSupply    Boolean    @default(false)
  notes               String?
  createdAt           DateTime   @default(now())
}